VITE_API_URL=http://localhost:5000/api

# Optional — Google Cloud Console > APIs & Services > Credentials > "OAuth client ID"
# (Web application, authorized origin = this app's URL). The "Sign in with
# Google" button on Login/Register is hidden entirely if this is unset.
VITE_GOOGLE_CLIENT_ID=

# Optional — the public https URL of this app (no trailing path). Enables the
# canonical link and the absolute og:image / twitter:image URLs that link
# previews (Slack, WhatsApp, LinkedIn, X) require. Omit and they are skipped.
VITE_SITE_URL=

